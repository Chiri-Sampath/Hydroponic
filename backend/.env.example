# Environment — AgriSmart AI Backend
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# JWT
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database (MySQL via PyMySQL)
# Format: mysql+pymysql://user:password@host:port/database
DATABASE_URL=mysql+pymysql://agrismart:password@localhost:3306/agri_smart_ai

# Weather API (Open-Meteo — no key needed for basic tier)
WEATHER_API_BASE_URL=https://api.open-meteo.com

# Geocoding (OSM Nominatim — follow usage policy)
GEOCODING_API_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=AgriSmartAI/1.0 (contact@example.com)

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5500

# File uploads
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH_MB=10

# Rate limiting
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_AUTH=10 per minute

# Admin provisioning (used only by seed script)
ADMIN_EMAIL=admin@agrismart.local
ADMIN_PASSWORD=change-me-before-seeding
