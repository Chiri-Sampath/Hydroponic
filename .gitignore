# ============================================================
# AgriSmart AI — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# Virtual environments
venv/
env/
.venv/
.env_backup/
*venv*/
backend/venv*/

# Environment / secrets
.env
*.env.local
*.env.production
*.env.staging

# Flask / SQLAlchemy
instance/
*.db
*.sqlite3

# Uploads (lab reports, images)
uploads/
*.pdf
*.tiff
*.tif

# ML artifacts
backend/app/ml/models/*.pkl
backend/app/ml/models/*.joblib
backend/app/ml/models/*.json
backend/app/ml/models/*.bin

# Logs
*.log
logs/

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

# Node (if frontend tooling is added)
node_modules/
npm-debug.log*
yarn-error.log*

# Build output
frontend/dist/

# Temporary extraction
docx_content.txt
